# =============================================================================
# ESTANCIA PERU - Variables de Entorno
# =============================================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Cambia los valores marcados con *** CAMBIAR EN PRODUCCION ***
# 3. NUNCA subas el archivo .env a Git (ya esta en .gitignore)
# =============================================================================

# Entorno de ejecucion: development | staging | production
NODE_ENV=development

# =============================================================================
# BASE DE DATOS - PostgreSQL
# =============================================================================
DB_USER=estancia_user
DB_PASSWORD=estancia_pass          # *** CAMBIAR EN PRODUCCION ***
DB_NAME=estanciaperu_db
DB_PORT=5432
DATABASE_URL="postgresql://estancia_user:estancia_pass@localhost:5432/estanciaperu_db?schema=public"

# =============================================================================
# REDIS - Event Bus y WebSockets
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass          # *** CAMBIAR EN PRODUCCION ***

# =============================================================================
# AUTENTICACION - JWT
# =============================================================================
JWT_SECRET=cambia_esto_en_produccion_usa_un_string_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# =============================================================================
# BACKEND - NestJS
# =============================================================================
API_PORT=3000

# =============================================================================
# FRONTEND - Next.js Shell
# =============================================================================
SHELL_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_MFE_EXPEDIENTES_URL=http://localhost:4201
NEXT_PUBLIC_MFE_EVALUACION_URL=http://localhost:4202