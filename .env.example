# EstanciaPeru

NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://estancia_user:estancia_pass@localhost:5432/estanciaperu_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# API
API_PORT=3000
API_PREFIX=api/v1

# Frontend Shell
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
