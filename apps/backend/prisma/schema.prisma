generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id          Int          @id
  codigo      String       @unique
  nombre      String
  descripcion String?
  usuarios    UsuarioRol[]

  @@map("roles")
}

model Usuario {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String       @default("")
  nombre        String
  apellido      String
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  roles         UsuarioRol[]
  solicitudes   Solicitud[]
  expedientes   Expediente[]
  evaluaciones  Evaluacion[]
  firmas        Firma[]
  historial     Historial[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model UsuarioRol {
  usuarioId String
  rolId     Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  asignadoEn DateTime @default(now())

  @@id([usuarioId, rolId])
  @@map("usuario_roles")
}

enum EstadoSolicitud {
  BORRADOR
  ENVIADA
  EN_REVISION
  APROBADA
  RECHAZADA
}

model Solicitud {
  id            String          @id @default(cuid())
  titulo        String
  descripcion   String
  estado        EstadoSolicitud @default(BORRADOR)
  solicitanteId String
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  solicitante Usuario     @relation(fields: [solicitanteId], references: [id])
  expediente  Expediente?
  historial   Historial[]

  @@map("solicitudes")
}

enum EstadoExpediente {
  INICIADO
  DOCUMENTACION_PENDIENTE
  EN_EVALUACION
  OBSERVADO
  APROBADO
  RECHAZADO
  CERRADO
}

model Expediente {
  id            String           @id @default(cuid())
  codigo        String           @unique
  estado        EstadoExpediente @default(INICIADO)
  solicitudId   String           @unique
  gestorId      String
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  solicitud    Solicitud    @relation(fields: [solicitudId], references: [id])
  gestor       Usuario      @relation(fields: [gestorId], references: [id])
  documentos   Documento[]
  evaluaciones Evaluacion[]
  historial    Historial[]

  @@map("expedientes")
}

model Documento {
  id           String   @id @default(cuid())
  nombre       String
  url          String
  tipo         String
  expedienteId String
  creadoEn     DateTime @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  votos      Voto[]

  @@map("documentos")
}

enum TipoVoto {
  APROBADO
  OBSERVADO
  RECHAZADO
}

model Voto {
  id          String   @id @default(cuid())
  documentoId String
  evaluadorId String
  tipo        TipoVoto
  comentario  String?
  creadoEn    DateTime @default(now())

  documento Documento @relation(fields: [documentoId], references: [id])

  @@unique([documentoId, evaluadorId])
  @@map("votos")
}

enum ResultadoEvaluacion {
  APROBADO
  APROBADO_CON_OBSERVACIONES
  NO_APROBADO
}

model Evaluacion {
  id               String               @id @default(cuid())
  expedienteId     String
  evaluadorId      String
  principiosEticos String?
  normativaLegal   String?
  resultado        ResultadoEvaluacion?
  recomendacion    String?
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  evaluador  Usuario    @relation(fields: [evaluadorId], references: [id])
  firmas     Firma[]

  @@map("evaluaciones")
}

model Firma {
  id           String   @id @default(cuid())
  evaluacionId String
  firmadoPor   String
  firma        String
  creadoEn     DateTime @default(now())

  evaluacion Evaluacion @relation(fields: [evaluacionId], references: [id])
  usuario    Usuario    @relation(fields: [firmadoPor], references: [id])

  @@map("firmas")
}

model Historial {
  id           String   @id @default(cuid())
  entidad      String
  entidadId    String
  evento       String
  descripcion  String?
  usuarioId    String?
  solicitudId  String?
  expedienteId String?
  metadata     Json?
  creadoEn     DateTime @default(now())

  usuario    Usuario?    @relation(fields: [usuarioId], references: [id])
  solicitud  Solicitud?  @relation(fields: [solicitudId], references: [id])
  expediente Expediente? @relation(fields: [expedienteId], references: [id])

  @@map("historial")
}

enum CanalNotificacion {
  EMAIL
  SISTEMA
  WEBSOCKET
}

model Notificacion {
  id        String            @id @default(cuid())
  usuarioId String
  titulo    String
  mensaje   String
  canal     CanalNotificacion @default(SISTEMA)
  leida     Boolean           @default(false)
  creadoEn  DateTime          @default(now())

  @@map("notificaciones")
}

model RefreshToken {
  id             String    @id @default(uuid())
  tokenHash      String    @unique          // sha256 del token (nunca el token en claro)
  familyId       String                      // misma cadena de rotación = un login/dispositivo
  familiaInicio  DateTime                    // inicio de la familia (para el máximo absoluto)
  usuarioId      String
  revocado       Boolean   @default(false)
  revocadoEn     DateTime?
  reemplazadoPor String?                     // id del token que lo sustituyó al rotar
  expiraEn       DateTime
  creadoEn       DateTime  @default(now())
  userAgent      String?
  ip             String?

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familyId])
  @@index([expiraEn])
  @@map("refresh_tokens")
}

