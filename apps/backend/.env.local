# Configuración para entorno FUERA DE DOCKER (Local nativo o Nube)
# Descomenta y ajusta la URL que corresponda a tu instalación:

# Opción A: PostgreSQL instalado nativamente en Windows (usuario por defecto 'postgres')
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estanciaperu_db?schema=public"

# Opción B: PostgreSQL en la nube (ejemplo Neon Serverless o Supabase)
# DATABASE_URL="postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/estanciaperu_db?sslmode=require"

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
