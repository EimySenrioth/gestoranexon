@echo off
title EstanciaPeru - Dev Environment
color 0A

echo.
echo  ????????????????????????????????????????????
echo  ?       ESTANCIAPERU - DEV STARTUP         ?
echo  ????????????????????????????????????????????
echo.
echo  Iniciando todos los servicios...
echo.

:: Backend - NestJS (Puerto 3000)
echo  [1/4] Iniciando Backend NestJS (http://localhost:3000)...
Start-Process cmd -ArgumentList "/k", "cd /d %~dp0apps\backend && npm run start:dev"

timeout /t 2 /nobreak >nul

:: React Shell - Next.js (Puerto 3001)
echo  [2/4] Iniciando React Shell Next.js (http://localhost:3001)...
start "Shell - Next.js :3001" cmd /k "cd /d %~dp0apps\shell && npm run dev -- --port 3001"

timeout /t 2 /nobreak >nul

:: MFE Expedientes - Angular (Puerto 4201)
echo  [3/4] Iniciando MFE Expedientes Angular (http://localhost:4201)...
start "MFE Expedientes - Angular :4201" cmd /k "cd /d %~dp0apps\mfe-expedientes && ng serve --port 4201"

timeout /t 2 /nobreak >nul

:: MFE Evaluacion - Angular (Puerto 4202)
echo  [4/4] Iniciando MFE Evaluacion Angular (http://localhost:4202)...
start "MFE Evaluacion - Angular :4202" cmd /k "cd /d %~dp0apps\mfe-evaluacion && ng serve --port 4202"

echo.
echo  ????????????????????????????????????????????
echo  ?   Todos los servicios iniciados          ?
echo  ?                                          ?
echo  ?   Backend:          http://localhost:3000?
echo  ?   React Shell:      http://localhost:3001?
echo  ?   MFE Expedientes:  http://localhost:4201?
echo  ?   MFE Evaluacion:   http://localhost:4202?
echo  ????????????????????????????????????????????
echo.
echo  Esta ventana se cerrara en 5 segundos...
timeout /t 5 /nobreak >nul
exit
